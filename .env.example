# Copie para .env (servidor) e preencha. Nunca versionar o .env real.
# Gere o segredo com: openssl rand -hex 32
SESSION_SECRET=
DATABASE_PATH=./data/casa.db

# Tema visual: cordel (xilogravura da Casa Mamaco, padrão) ou xepa (KV do site do Grupo XEPA).
# Vale no build: depois de trocar, rode `docker compose up -d --build`.
NEXT_PUBLIC_THEME=cordel

# Segundo cadeado (senha do navegador) na frente de todo o site. O hash gera-se com:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'SUA-SENHA'
# Use aspas simples no valor (o hash tem '$').
GATE_USER=casa
GATE_HASH=
